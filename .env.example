# Copy to .env and fill in. .env is git-ignored: never commit real tokens.

# Where chart candles/quotes come from: demo | oanda | metaapi
MARKET_DATA=demo
# Where orders go: paper | oanda | metaapi  (paper = simulated, in memory)
EXECUTION=paper

# Where `npm run download` stores one-minute history for replay mode
HISTORY_DIR=data/history

# Server bind address. Keep 127.0.0.1: the API has no login, anyone who can reach it can trade.
HOST=127.0.0.1
PORT=3001

# --- OANDA (https://www.oanda.com/demo-account/tpa/personal_token) ---
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENV=practice
# Units per 1.00 lot when sending orders to OANDA
OANDA_UNITS_PER_LOT=100000

# --- MetaApi / MetaTrader (https://app.metaapi.cloud/token) ---
METAAPI_TOKEN=
# The MetaApi account id (not your MT login number)
METAAPI_ACCOUNT_ID=
# Some brokers suffix symbols, e.g. EURUSD.m or EURUSDm
METAAPI_SYMBOL_SUFFIX=
# Set true if the MetaTrader account is a real-money account (shows a LIVE badge)
METAAPI_LIVE=false
